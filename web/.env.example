# Адрес Supabase (self-hosted, серверы в РФ) и публичный anon-ключ
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только на сервере: service key и ключ шифрования ключей ЮKassa (base64, 32 байта: openssl rand -base64 32)
SUPABASE_SERVICE_ROLE_KEY=
GYM_SECRETS_KEY=
# Публичный адрес кабинета (для ссылок в письмах и возврата после оплаты)
PUBLIC_APP_URL=http://localhost:3000
